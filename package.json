{
  "name": "tunnel-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestor local de subdominios sobre un unico Cloudflare Tunnel",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tunnel-manager": "./dist/cli/index.js"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "run-p dev:server dev:web",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/index.js --open"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.4",
    "qrcode": "^1.5.4"
  }
}
