{
  "name": "tunnel-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestor local de subdominios sobre un unico Cloudflare Tunnel",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tunnel-manager": "./dist/cli/index.js"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
