# --- Credenciales (NUNCA commitear el .env real) ---
#
# Token de API. Permisos requeridos, ambos sobre "Entire Account" / la zona:
#
#   Argo Tunnel (Legacy) > Edit    <- leer/escribir las reglas de ingress del tunel
#   Zone > DNS > Edit              <- crear/borrar los CNAME
#
# OJO con el grupo de permisos: en el UI actual de Cloudflare NO existe un grupo
# llamado "Cloudflare Tunnel". Buscando "Tunnel" salen dos y solo uno sirve:
#   - "Argo Tunnel (Legacy)"    -> SI. Es el scope de los endpoints /accounts/*/cfd_tunnel/*
#   - "Connectivity Directory"  -> NO. Es el modelo nuevo de networking, otros endpoints.
#
# Sintoma de que te falta el permiso del tunel: listar tuneles NO da 403, da
# success:true con total_count:0, como si no tuvieras ninguno.
#
# Si tu token empieza con "cfat_" es account-owned. Dos consecuencias:
#   1. Se administra en Manage Account > API Tokens, no en My Profile > API Tokens.
#   2. /user/tokens/verify SIEMPRE lo rechaza con [1000] Invalid API Token, aunque
#      el token este perfecto. Es un falso negativo. Verificalo asi:
#        curl -H "Authorization: Bearer $CF_API_TOKEN" \
#          https://api.cloudflare.com/client/v4/accounts/{account_id}/tokens/verify
#      (con GET; POST devuelve [7001] Method POST not available for that URI)
CF_API_TOKEN=

# --- IDs (no son secretos) ---
CF_ACCOUNT_ID=986d5e56302f08e1bef9af317f68acca
CF_ZONE_ID=
CF_TUNNEL_ID=e7c0265f-ef68-4802-9fa0-3e8b007cbcf1
BASE_DOMAIN=nurbs.dev

# --- Opcional: solo para mode=spawn ---
# Token del tunel (el blob largo de `cloudflared service install <token>`).
# En mode=service (el default) no se usa.
CF_TUNNEL_TOKEN=
